{
  "name": "Movie BI Light v2",
  "dataColors": [
    "#6B5BD2",
    "#AFA9EC",
    "#16A085",
    "#9FE1CB",
    "#E8623C",
    "#F0997B",
    "#3D7DD8",
    "#8A8A93"
  ],
  "background": "#FFFFFF",
  "foreground": "#2C2C2A",
  "foregroundNeutralSecondary": "#5F5E5A",
  "foregroundNeutralTertiary": "#9A9AA0",
  "tableAccent": "#6B5BD2",
  "good": "#16A085",
  "neutral": "#E0A526",
  "bad": "#E24B4A",
  "maximum": "#6B5BD2",
  "center": "#C9C7D6",
  "minimum": "#EEEDFE",
  "textClasses": {
    "title": { "fontFace": "Segoe UI Semibold", "fontSize": 13, "color": "#2C2C2A" },
    "header": { "fontFace": "Segoe UI Semibold", "fontSize": 12, "color": "#2C2C2A" },
    "label": { "fontFace": "Segoe UI", "fontSize": 10, "color": "#5F5E5A" },
    "callout": { "fontFace": "Segoe UI Semibold", "fontSize": 28, "color": "#6B5BD2" }
  },
  "visualStyles": {
    "page": {
      "*": {
        "background": [ { "color": { "solid": { "color": "#F4F4F8" } }, "transparency": 0 } ],
        "outspace": [ { "color": { "solid": { "color": "#F4F4F8" } }, "transparency": 0 } ]
      }
    },
    "*": {
      "*": {
        "background": [ { "show": true, "color": { "solid": { "color": "#FFFFFF" } }, "transparency": 0 } ],
        "border": [ { "show": true, "color": { "solid": { "color": "#E3E3EA" } }, "radius": 12 } ],
        "dropShadow": [ { "show": false } ],
        "title": [
          {
            "show": true,
            "fontColor": { "solid": { "color": "#2C2C2A" } },
            "background": { "solid": { "color": "#FFFFFF" } },
            "alignment": "left",
            "fontSize": 13,
            "fontFamily": "Segoe UI Semibold"
          }
        ],
        "legend": [
          {
            "show": true,
            "position": "Top",
            "labelColor": { "solid": { "color": "#5F5E5A" } },
            "fontSize": 11
          }
        ],
        "categoryAxis": [
          {
            "show": true,
            "labelColor": { "solid": { "color": "#5F5E5A" } },
            "fontSize": 10,
            "gridlineShow": false
          }
        ],
        "valueAxis": [
          {
            "show": true,
            "labelColor": { "solid": { "color": "#5F5E5A" } },
            "fontSize": 10,
            "gridlineShow": true,
            "gridlineColor": { "solid": { "color": "#ECECF1" } },
            "gridlineThickness": 1,
            "gridlineStyle": "dotted"
          }
        ]
      }
    },
    "card": {
      "*": {
        "background": [ { "show": true, "color": { "solid": { "color": "#FFFFFF" } }, "transparency": 0 } ],
        "labels": [ { "color": { "solid": { "color": "#6B5BD2" } }, "fontSize": 28, "fontFamily": "Segoe UI Semibold" } ],
        "categoryLabels": [ { "color": { "solid": { "color": "#5F5E5A" } }, "fontSize": 11 } ]
      }
    },
    "slicer": {
      "*": {
        "background": [ { "show": true, "color": { "solid": { "color": "#FFFFFF" } }, "transparency": 0 } ],
        "border": [ { "show": true, "color": { "solid": { "color": "#E3E3EA" } }, "radius": 10 } ]
      }
    }
  }
}
